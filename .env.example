# GitHub App "SEASI Website Editor" (GitHub → Settings → Developer settings → GitHub Apps)
# Used by the /edit login (netlify/functions/auth + callback).
# Copy this file to .env and fill in. In production, set the same vars in Netlify → Environment variables.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Primary domain (no trailing slash). Used for share-preview URLs and as the login redirect allowlist.
NUXT_PUBLIC_SITE_URL=https://seasi.org
